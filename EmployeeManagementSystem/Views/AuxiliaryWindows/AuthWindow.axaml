<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EmployeeManagementSystem.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EmployeeManagementSystem.Views.AuxiliaryWindows.AuthWindow"
        Title="AuthWindow"
        x:DataType="viewModels:AuthWindowViewModel"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight">
        
        <Grid ColumnDefinitions="* Auto" RowDefinitions="Auto Auto *">
                <TextBox Grid.Row="0" Grid.Column="0" Watermark="Логин" Text="{Binding Login}" HorizontalAlignment="Stretch" MinWidth="150"></TextBox>
                <TextBox Grid.Row="1" Grid.Column="0" Watermark="Пароль" Text="{Binding Password}" HorizontalAlignment="Stretch" PasswordChar="*" RevealPassword="{Binding ShowPassword}" MinWidth="150"></TextBox>
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ShowPassword}" HorizontalAlignment="Left" Margin="10,0,0,0"></CheckBox>
                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Command="{Binding EnterCommand}" Content="{Binding ButtonText}"></Button>
        </Grid>
        
</Window>

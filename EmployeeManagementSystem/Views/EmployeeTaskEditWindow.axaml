<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EmployeeManagementSystem.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EmployeeManagementSystem.Views.EmployeeTaskEditWindow"
        Title="EmployeeTaskEditWindow"
        x:DataType="viewModels:EmployeeTaskEditWindowViewModel">
        <Grid RowDefinitions="Auto Auto Auto Auto Auto *" ColumnDefinitions="Auto Auto *">
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Задача"></TextBlock>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TaskGoal}"></TextBox>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Описание: "></TextBlock>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TaskDescription}"></TextBox>
                
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Назначенный сотрудник: "></TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEmployee.FullName}"></TextBlock>
                <Button Grid.Row="2" Grid.Column="2" Content="Выбрать" Command="{Binding OpenEmployeeSelectorCommand}"></Button>
                
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Срочность: "></TextBlock>
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding UrgencyList}" SelectedItem="{Binding SelectedUrgency}">
                        <ComboBox.ItemTemplate>
                                <DataTemplate>
                                        <TextBlock Text="{Binding Title}"></TextBlock>
                                </DataTemplate>
                        </ComboBox.ItemTemplate>
                </ComboBox>
                
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Крайний срок выполнения задачи: "></TextBlock>
                <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding DeadLine}"></DatePicker>
                
                <Button Grid.Row="5" Grid.Column="0" Content="Сохранить" HorizontalAlignment="Center" Command="{Binding SaveCommand}" Margin="0,0,5,10"></Button>
                <Button Grid.Row="5" Grid.Column="2" Content="Отмена" HorizontalAlignment="Center" Command="{Binding CancelCommand}" Margin="0,0,5,10"></Button>
        </Grid>
</Window>

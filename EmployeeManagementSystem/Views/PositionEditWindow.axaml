<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EmployeeManagementSystem.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EmployeeManagementSystem.Views.PositionEditWindow"
        Title="PositionEditWindow"
        x:DataType="viewModels:PositionEditWindowViewModel"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
        
        <Grid RowDefinitions="Auto *" ColumnDefinitions="Auto *">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Название"></TextBlock>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title}"></TextBox>
                
                <Button Grid.Row="1" Grid.Column="0" Content="Сохранить" HorizontalAlignment="Center" Command="{Binding SaveCommand}" Margin="0,0,5,10"></Button>
                <Button Grid.Row="1" Grid.Column="1" Content="Отмена" HorizontalAlignment="Center" Command="{Binding CancelCommand}" Margin="0,0,5,10"></Button>
        </Grid>
        
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EmployeeManagementSystem.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EmployeeManagementSystem.Views.BonusEditWindow"
        Title="BonusEditWindow"
        x:DataType="viewModels:BonusEditWindowViewModel"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight">
    
    <Grid RowDefinitions="Auto Auto Auto Auto *" ColumnDefinitions="Auto Auto *">
                <Button Grid.Row="4" Grid.Column="0" Content="Сохранить" HorizontalAlignment="Center" Command="{Binding SaveCommand}" Margin="0,0,5,10"></Button>
                <Button Grid.Row="4" Grid.Column="2" Content="Отмена" HorizontalAlignment="Center" Command="{Binding CancelCommand}" Margin="0,0,5,10"></Button>
        </Grid>
        
</Window>
